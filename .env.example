APP_ENV=development
LOG_LEVEL=INFO
BITGET_REST_URL=https://api.bitget.com
BITGET_REQUEST_TIMEOUT_SECONDS=10
BITGET_MAX_RETRIES=3
BITGET_RETRY_DELAY_SECONDS=0.5
BITGET_RATE_LIMIT_WAIT_SECONDS=0.05
BITGET_HISTORY_CONCURRENCY=4
BITGET_WS_URL=wss://ws.bitget.com/v2/ws/public
POSTGRES_DB=quant_radar
POSTGRES_USER=quant
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://quant:change-me@postgres:5432/quant_radar
REDIS_URL=redis://redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WECOM_WEBHOOK_URL=
